# ──────────────────────────────────────────────────────────────────────────────
# Movo — шаблон переменных окружения
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. Скопируй этот файл: cp .env.example .env
#   2. Заполни каждое значение своими данными
#   3. Файл .env добавлен в .gitignore — он НИКОГДА не попадёт в репозиторий
# ──────────────────────────────────────────────────────────────────────────────

# ── База данных ────────────────────────────────────────────────────────────────
# Строка подключения к MongoDB Atlas (или локальной инстанции).
# Формат Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?...
MONGODB_URI=YOUR_MONGODB_URI_HERE

# ── Аутентификация ─────────────────────────────────────────────────────────────
# Секрет для подписи JWT-токенов. Используй длинную случайную строку.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Внешние API ────────────────────────────────────────────────────────────────
# API-ключ Groq для сканирования чеков (llama-3.2-vision).
# Получить: https://console.groq.com/keys
GROQ_API=YOUR_GROQ_API_KEY_HERE

# API-ключ xAI / Grok Vision (запасной провайдер для сканера чеков).
# Получить: https://console.x.ai/
XAI_API_KEY=YOUR_XAI_API_KEY_HERE

# ── Flutter / Мобильное приложение ─────────────────────────────────────────────
# Базовый URL бэкенда для Flutter-клиента.
# При разработке: http://localhost:3000/api
# В продакшене передаётся через --dart-define=API_BASE_URL=https://your-domain.com/api
API_BASE_URL=http://localhost:3000/api

# Таймаут HTTP-запросов в миллисекундах (default: 30000 = 30 секунд).
API_TIMEOUT=30000

# ── Режим разработки ───────────────────────────────────────────────────────────
# true — включить расширенное логирование и отладочные данные.
DEBUG_MODE=true
